# Configure these names in Replit Secrets or server-side environment variables.
# This app does not load a local .env file automatically.
# Never commit real keys or passwords.

# Required to unlock demo-owner controls. Use independent random secrets.
# Minimum 32 characters for the signing key; minimum 24 for the owner access code.
# If either is missing or too short, the app remains read-only.
FLASK_SECRET_KEY=
ORDERGUARD_OWNER_ACCESS_CODE=

# HTTPS cookies are the default. Set false only for local HTTP development.
ORDERGUARD_COOKIE_SECURE=true
ORDERGUARD_DB=orderguard.db

# Optional AI extraction. The app still works with human-confirmed fields when omitted.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
