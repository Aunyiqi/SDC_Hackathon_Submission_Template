run = "bash -lc 'python -m venv .venv && env PIP_CONFIG_FILE=/dev/null PIP_USER=false .venv/bin/python -m pip install --disable-pip-version-check -r requirements.web.txt && exec .venv/bin/python src/main.py'"
entrypoint = "src/main.py"
modules = ["python-base-3.13"]

[nix]
channel = "stable-24_05"

packager.language = "python3"
packager.ignoredPaths = ["runpod", ".git", ".github", ".venv"]
packager.ignoredPackages = ["runpod", "easyocr", "torch", "torchvision", "cv2", "PIL"]

[packager.features]
guessImports = false
packageSearch = false
enabledForHosting = false

[deployment]
build = "python -m venv .venv && env PIP_CONFIG_FILE=/dev/null PIP_USER=false .venv/bin/python -m pip install --disable-pip-version-check --no-cache-dir -r requirements.web.txt"
run = ["bash", "-lc", "exec .venv/bin/gunicorn --chdir src --bind 0.0.0.0:${PORT:-5000} --workers 2 --threads 2 --timeout 120 app:app"]
deploymentTarget = "cloudrun"
